# CPU4: small 4-bit accumulator CPU.
#
# Architecture:
#   - 4-bit accumulator A
#   - 4-bit program counter PC
#   - 4-bit output register
#   - 8-bit instruction: [ opcode:4 ][ operand:4 ]
#   - Z flag derived from A
#   - one instruction per rising CLK edge
#
# Program storage uses the stock 256x16 ROM. CPU4 uses only addresses 0..15
# and the low byte of every ROM word.
chip CPU4
    in CLK, RESET
    out ACC: 4, PC: 4, OUT_PORT: 4, Z, HALTED, INSTR: 8, OPCODE: 4, OPERAND: 4

    # Fetch: pc and acc are registers further down. Using them here is the
    # feedback loop of the processor.
    rom = ROM(join(0b0000, pc))
    instruction = rom.OUT_A
    opcode = instruction[4..7]
    operand = instruction[0..3]

    # Opcodes:
    # 0 NOP       8 JZ addr
    # 1 LDI imm   9 JNZ addr
    # 2 ADDI imm  A NOT
    # 3 SUBI imm  B INC
    # 4 ANDI imm  C DEC
    # 5 ORI imm   D reserved
    # 6 XORI imm  E OUT
    # 7 JMP addr  F HLT
    ldi = opcode == 0x1
    addi = opcode == 0x2
    subi = opcode == 0x3
    andi = opcode == 0x4
    ori = opcode == 0x5
    xori = opcode == 0x6
    jmp = opcode == 0x7
    jz = opcode == 0x8
    jnz = opcode == 0x9
    inv = opcode == 0xA
    inc = opcode == 0xB
    dec = opcode == 0xC
    out_op = opcode == 0xE
    hlt = opcode == 0xF

    running = not halted
    zero = acc == 0

    # Accumulator
    acc_d = if ldi then operand
        else if addi then acc + operand
        else if subi then acc - operand
        else if andi then acc and operand
        else if ori then acc or operand
        else if xori then acc xor operand
        else if inv then not acc
        else if inc then acc + 1
        else if dec then acc - 1
        else acc
    writes_acc = ldi or addi or subi or andi or ori or xori or inv or inc or dec
    acc = Reg4(acc_d, running and writes_acc, CLK, RESET)

    # Output port
    out_port = Reg4(acc, running and out_op, CLK, RESET)

    # Halt flag: set by HLT, cleared by RESET.
    halt_d = if RESET then 0 else if running and hlt then 1 else halted
    halted, _ = DffBit(halt_d, CLK)

    # Program counter
    take_branch = jmp or jz and zero or jnz and not zero
    pc_d = if take_branch then operand else pc + 1
    pc = Reg4(pc_d, running and not hlt, CLK, RESET)

    ACC = acc
    PC = pc
    OUT_PORT = out_port
    Z = zero
    HALTED = halted
    INSTR = instruction
    OPCODE = opcode
    OPERAND = operand
