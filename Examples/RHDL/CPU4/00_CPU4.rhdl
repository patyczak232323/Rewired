# CPU4: small 4-bit accumulator CPU.
#
# Architecture:
#   - 4-bit accumulator A
#   - 4-bit program counter PC
#   - 4-bit output register
#   - 8-bit instruction: [ opcode:4 ][ operand:4 ]
#   - Z flag derived from A
#   - one instruction per rising CLK edge
#
# Program storage uses the stock 256x16 ROM. CPU4 uses only addresses 0..15
# and the low byte of every ROM word.
circuit CPU4(CLK, RESET) -> (
    ACC: u4, PC: u4, OUT_PORT: u4, Z, HALTED,
    INSTR: u8, OPCODE: u4, OPERAND: u4,
):
    # Fetch: pc and acc are registers further down. Using them here is the
    # feedback loop of the processor.
    rom = ROM(cat(0b0000, pc))
    instruction = rom.OUT_A
    opcode = instruction[4:8]
    operand = instruction[0:4]

    # Opcodes:
    # 0 NOP       8 JZ addr
    # 1 LDI imm   9 JNZ addr
    # 2 ADDI imm  A NOT
    # 3 SUBI imm  B INC
    # 4 ANDI imm  C DEC
    # 5 ORI imm   D reserved
    # 6 XORI imm  E OUT
    # 7 JMP addr  F HLT
    ldi = opcode == 0x1
    addi = opcode == 0x2
    subi = opcode == 0x3
    andi = opcode == 0x4
    ori = opcode == 0x5
    xori = opcode == 0x6
    jmp = opcode == 0x7
    jz = opcode == 0x8
    jnz = opcode == 0x9
    inv = opcode == 0xA
    inc = opcode == 0xB
    dec = opcode == 0xC
    out = opcode == 0xE
    hlt = opcode == 0xF

    running = not halted
    zero = acc == 0

    # Accumulator
    acc_d = (
        operand if ldi else
        acc + operand if addi else
        acc - operand if subi else
        acc & operand if andi else
        acc | operand if ori else
        acc ^ operand if xori else
        ~acc if inv else
        acc + 1 if inc else
        acc - 1 if dec else
        acc
    )
    writes_acc = ldi or addi or subi or andi or ori or xori or inv or inc or dec
    acc = Reg4(acc_d, running and writes_acc, CLK, RESET)

    # Output port
    out_port = Reg4(acc, running and out, CLK, RESET)

    # Halt flag: set by HLT, cleared by RESET.
    halt_d = 0 if RESET else (1 if running and hlt else halted)
    halted, _ = DffBit(halt_d, CLK)

    # Program counter
    take_branch = jmp or (jz and zero) or (jnz and not zero)
    pc_d = operand if take_branch else pc + 1
    pc = Reg4(pc_d, running and not hlt, CLK, RESET)

    ACC = acc
    PC = pc
    OUT_PORT = out_port
    Z = zero
    HALTED = halted
    INSTR = instruction
    OPCODE = opcode
    OPERAND = operand
