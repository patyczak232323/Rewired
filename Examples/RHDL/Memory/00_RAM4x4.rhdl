# 4 x 4-bit RAM built from four Reg4 registers.
#
# Address:
#   A1 A0 = 00 -> word 0
#           01 -> word 1
#           10 -> word 2
#           11 -> word 3
#
# WE is sampled on the rising CLK edge.
# RESET clears all four words synchronously.
circuit Ram4x4(D: u4, A0, A1, WE, CLK, RESET) -> Q: u4:
    word0 = Reg4(D, WE & ~A1 & ~A0, CLK, RESET)
    word1 = Reg4(D, WE & ~A1 & A0, CLK, RESET)
    word2 = Reg4(D, WE & A1 & ~A0, CLK, RESET)
    word3 = Reg4(D, WE & A1 & A0, CLK, RESET)

    low = word1 if A0 else word0
    high = word3 if A0 else word2
    Q = high if A1 else low
