# 4 x 4-bit RAM built from four Reg4 registers.
#
# Address:
#   A1 A0 = 00 -> word 0
#           01 -> word 1
#           10 -> word 2
#           11 -> word 3
#
# WE is sampled on the rising CLK edge.
# RESET clears all four words synchronously.
chip Ram4x4
    in D: 4, A0, A1, WE, CLK, RESET
    out Q: 4

    word0 = Reg4(D, WE and not A1 and not A0, CLK, RESET)
    word1 = Reg4(D, WE and not A1 and A0, CLK, RESET)
    word2 = Reg4(D, WE and A1 and not A0, CLK, RESET)
    word3 = Reg4(D, WE and A1 and A0, CLK, RESET)

    low = if A0 then word1 else word0
    high = if A0 then word3 else word2
    Q = if A1 then high else low
