# PIX6 computer: the PIX6 processor wired to the 64 x 64 screen.
#
# The screen takes the pen position and colour from the processor and draws
# on the same rising CLK edge on which the processor executes PLOT, SHOW or CLS.
circuit Pix6Computer(CLK, RESET) -> (PC: u8, HALTED):
    cpu = Pix6(CLK, RESET)
    RGB_DISPLAY_64(cpu.X, cpu.Y, cpu.R, cpu.G, cpu.B, cpu.CLS, cpu.PLOT, cpu.SHOW, CLK)
    PC = cpu.PC
    HALTED = cpu.HALTED
