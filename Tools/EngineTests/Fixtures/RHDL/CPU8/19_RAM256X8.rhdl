# 256 x 8-bit RAM: sixteen Ram16x8 banks. The high four address bits choose
# the bank (Dec4 for writing, Mux16x8 for reading), the low four the word.
chip Ram256x8
    in D: 8, A: 8, WE, CLK
    out Q: 8

    word = A[0..3]
    bank = A[4..7]
    w = Dec4(bank, WE)
    b0 = Ram16x8(D, word, w.Y0, CLK)
    b1 = Ram16x8(D, word, w.Y1, CLK)
    b2 = Ram16x8(D, word, w.Y2, CLK)
    b3 = Ram16x8(D, word, w.Y3, CLK)
    b4 = Ram16x8(D, word, w.Y4, CLK)
    b5 = Ram16x8(D, word, w.Y5, CLK)
    b6 = Ram16x8(D, word, w.Y6, CLK)
    b7 = Ram16x8(D, word, w.Y7, CLK)
    b8 = Ram16x8(D, word, w.Y8, CLK)
    b9 = Ram16x8(D, word, w.Y9, CLK)
    b10 = Ram16x8(D, word, w.Y10, CLK)
    b11 = Ram16x8(D, word, w.Y11, CLK)
    b12 = Ram16x8(D, word, w.Y12, CLK)
    b13 = Ram16x8(D, word, w.Y13, CLK)
    b14 = Ram16x8(D, word, w.Y14, CLK)
    b15 = Ram16x8(D, word, w.Y15, CLK)
    Q = Mux16x8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, bank)
