# 8-bit rising-edge register built from eight DffBit instances.
# RESET is synchronous: it clears the register on the next rising CLK edge.
chip Reg8
    in D: 8, WE, CLK, RESET
    out Q: 8

    for i in 0..7
        d = if RESET then 0 else if WE then D[i] else Q[i]
        Q[i], _ = DffBit(d, CLK)
    end
