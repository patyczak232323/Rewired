# PIX6: a small processor that draws on the 64 x 64 screen.
#
# Architecture:
#   - X and Y registers (6 bits used): the pen position
#   - two spare pens, B and F, that SWAP exchanges with the pen
#   - colour register: 4 bits each of red, green and blue
#   - direction D and next direction N, set from the KEYS input
#   - delay counter T, grow counter G and a random number generator
#   - 8-bit program counter, so 256 program words
#   - 16-bit instruction: [ opcode:4 ][ argument:12 ]
#   - one instruction per rising CLK edge
#
# The program lives in the stock 256x16 ROM. The screen is not inside the
# processor: X, Y, R, G, B, PLOT, SHOW and CLS go to its pins and the colour
# it shows at (X, Y) comes back on SCREEN_R/G/B (see 02_PIX6_COMPUTER).
# KEYS bits are the directions: 0 right, 1 up, 2 left, 3 down.
chip Pix6
    in CLK, RESET, KEYS: 4, SCREEN_R: 4, SCREEN_G: 4, SCREEN_B: 4
    out X: 8, Y: 8, R: 4, G: 4, B: 4, PLOT, SHOW, CLS, PC: 8, HALTED, OPCODE: 4

    # Fetch. The registers are further down: using them here is the
    # feedback loop of the processor.
    rom = ROM(pc)
    instruction = join(rom.OUT_B, rom.OUT_A)
    opcode = instruction[12..15]
    arg = instruction[0..11]
    target = instruction[0..7]

    # Opcodes (word = 0xOAAA):
    # 0 extended (below)  8 JMP a
    # 1 SETX n            9 JXNZ a   jump if X != 0
    # 2 SETY n            A JYNZ a   jump if Y != 0
    # 3 SETC rgb          B PAT      colour from X and Y
    # 4 ADDC rgb          C SHOW     show the drawn picture
    # 5 PLOT              D CLS      clear the drawing (not the shown picture)
    # 6 INCX              E PLOTX    PLOT, then INCX
    # 7 INCY              F HLT
    setx = opcode == 0x1
    sety = opcode == 0x2
    setc = opcode == 0x3
    addc = opcode == 0x4
    plot = opcode == 0x5
    incx = opcode == 0x6
    incy = opcode == 0x7
    jmp = opcode == 0x8
    jxnz = opcode == 0x9
    jynz = opcode == 0xA
    pat = opcode == 0xB
    show = opcode == 0xC
    cls = opcode == 0xD
    plotx = opcode == 0xE
    hlt = opcode == 0xF

    # Extended instructions (word = 0x0Saa):
    # 00 NOP              08 KEYS     N <- pressed direction, unless it reverses D
    # 01 SWAP B / SWAP F  09 JKEY a   jump if a key is pressed
    # 02 TURN   D <- N    0A RND      pen <- random position
    # 03 STEP   move by D 0B JCZ a    jump if colour == 0
    # 04 STEPC  move by   0C SETT n   T <- n * 16
    #    colour bits 0-1  0D DJNZ a   T <- T - 1, jump if T != 0
    # 05 READ   colour <- 0E GROW n   G <- G + n
    #    shown pixel      0F JGROW a  if G != 0: G <- G - 1 and jump
    # 06 DCOL   colour bits 0-1 <- D
    # 07 ERASE  draw black at the pen
    ext = opcode == 0x0
    sub = arg[8..11]
    small = arg[0..7]
    swap_b = ext and sub == 0x1 and not small[0]
    swap_f = ext and sub == 0x1 and small[0]
    turn = ext and sub == 0x2
    step = ext and sub == 0x3
    stepc = ext and sub == 0x4
    read = ext and sub == 0x5
    dcol = ext and sub == 0x6
    erase = ext and sub == 0x7
    keys = ext and sub == 0x8
    jkey = ext and sub == 0x9
    rnd = ext and sub == 0xA
    jcz = ext and sub == 0xB
    sett = ext and sub == 0xC
    djnz = ext and sub == 0xD
    grow = ext and sub == 0xE
    jgrow = ext and sub == 0xF

    running = not halted

    # Directions: 0 right, 1 up, 2 left, 3 down.
    d = dr[0..1]
    n = nr[0..1]
    key_pressed = KEYS != 0
    key_dir = if KEYS[0] then 0b00 else if KEYS[1] then 0b01 else if KEYS[2] then 0b10 else 0b11
    accept_key = keys and key_pressed and (key_dir xor d) != 0b10
    n_d = if accept_key then key_dir else n
    d_d = if turn then n else d
    nr = Reg4(n_d, running, CLK, RESET)
    dr = Reg4(d_d, running, CLK, RESET)

    # Pen position. Both wrap around at 64.
    x = xr[0..5]
    y = yr[0..5]
    move = step or stepc
    move_dir = if step then d else colour[0..1]
    x_moved = if move_dir == 0 then x + 1 else if move_dir == 2 then x - 1 else x
    y_moved = if move_dir == 1 then y + 1 else if move_dir == 3 then y - 1 else y
    x_d = if setx then arg[0..5]
        else if incx or plotx then x + 1
        else if move then x_moved
        else if swap_b then bxr[0..5]
        else if swap_f then fxr[0..5]
        else if rnd then random[0..5]
        else x
    y_d = if sety then arg[0..5]
        else if incy then y + 1
        else if move then y_moved
        else if swap_b then byr[0..5]
        else if swap_f then fyr[0..5]
        else if rnd then random[6..11]
        else y
    xr = Reg8(x_d, running, CLK, RESET)
    yr = Reg8(y_d, running, CLK, RESET)

    # Spare pens: SWAP exchanges one of them with the pen.
    bxr = Reg8(xr, running and swap_b, CLK, RESET)
    byr = Reg8(yr, running and swap_b, CLK, RESET)
    fxr = Reg8(xr, running and swap_f, CLK, RESET)
    fyr = Reg8(yr, running and swap_f, CLK, RESET)

    # Colour, written 0xRGB like the argument of SETC.
    colour = join(red, green, blue)
    xy = x xor y
    pattern = join(x[2..5], y[2..5], xy[2..5])
    screen = join(SCREEN_R, SCREEN_G, SCREEN_B)
    colour_d = if setc then arg
        else if addc then colour + arg
        else if pat then pattern
        else if read then screen
        else if dcol then join(colour[2..11], d)
        else colour
    red = Reg4(colour_d[8..11], running, CLK, RESET)
    green = Reg4(colour_d[4..7], running, CLK, RESET)
    blue = Reg4(colour_d[0..3], running, CLK, RESET)

    # Delay counter T (12 bits) and grow counter G.
    t = join(t_high, t_low)
    t_next = t - 1
    t_d = if sett then join(small, 0b0000) else if djnz then t_next else t
    t_low = Reg8(t_d[0..7], running, CLK, RESET)
    t_high = Reg4(t_d[8..11], running, CLK, RESET)
    g_nonzero = g != 0
    g_d = if grow then g + small else if jgrow and g_nonzero then g - 1 else g
    g = Reg8(g_d, running, CLK, RESET)

    # Random numbers: a 16-bit LFSR that steps every cycle. The registers hold
    # it XOR a seed, so the all-zero state after RESET is a valid one.
    lfsr = join(rand_high, rand_low) xor 0xACE1
    lfsr_next = lfsr >> 1 xor (if lfsr[0] then 0xB400 else 0x0000)
    rand_d = lfsr_next xor 0xACE1
    rand_low = Reg8(rand_d[0..7], running, CLK, RESET)
    rand_high = Reg8(rand_d[8..15], running, CLK, RESET)
    random = lfsr

    # Halt flag: set by HLT, cleared by RESET.
    halt_d = if RESET then 0 else if running and hlt then 1 else halted
    halted, _ = DffBit(halt_d, CLK)

    # Program counter
    take_jump = jmp or jxnz and x != 0 or jynz and y != 0 or jkey and key_pressed or jcz and colour == 0 or djnz and t_next != 0 or jgrow and g_nonzero
    pc_d = if take_jump then target else pc + 1
    pc = Reg8(pc_d, running and not hlt, CLK, RESET)

    X = xr
    Y = yr
    R = if erase then 0 else red
    G = if erase then 0 else green
    B = if erase then 0 else blue
    PLOT = running and (plot or plotx or erase)
    SHOW = running and show
    CLS = running and cls
    PC = pc
    HALTED = halted
    OPCODE = opcode
