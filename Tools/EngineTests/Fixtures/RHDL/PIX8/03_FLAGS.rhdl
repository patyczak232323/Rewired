# Flag register: Z (zero), N (negative, bit 7) and C (carry / borrow), each a
# D flip-flop that loads on a rising CLK edge when its write enable is 1.
# RESET clears all three.
chip Flags
    in Z_IN, N_IN, C_IN, ZN_WE, C_WE, CLK, RESET
    out Z, N, C

    keep = Not(RESET)
    Z, _ = DffBit(And(Mux(Z_IN, Z, ZN_WE), keep), CLK)
    N, _ = DffBit(And(Mux(N_IN, N, ZN_WE), keep), CLK)
    C, _ = DffBit(And(Mux(C_IN, C, C_WE), keep), CLK)
